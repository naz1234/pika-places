{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pika-places-local",
  "pages_build_output_dir": "public",
  "compatibility_date": "2026-08-28",
  "d1_databases": [{ "binding": "DB", "database_name": "local-pika-places", "database_id": "00000000-0000-4000-8000-000000000001" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "local-pika-media" }]
}
